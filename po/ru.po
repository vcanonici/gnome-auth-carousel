msgid "Fingerprint"
msgstr "Отпечаток пальца"

msgid "Place your index finger on the fingerprint reader"
msgstr "Приложите указательный палец к сканеру отпечатков"

msgid "Fingerprint not recognized. Place your index finger again."
msgstr "Отпечаток не распознан. Приложите указательный палец ещё раз."

msgid "Connect your Trezor and confirm on the device"
msgstr "Подключите Trezor и подтвердите на устройстве"

msgid "Trezor not confirmed. Try again."
msgstr "Trezor не подтвердил. Попробуйте ещё раз."

msgid "Enter your password"
msgstr "Введите пароль"

msgid "Password"
msgstr "Пароль"

msgid "Too many attempts. Enter your password again."
msgstr "Слишком много попыток. Введите пароль ещё раз."

msgid "Try again. Enter your password."
msgstr "Попробуйте ещё раз. Введите пароль."

msgid "Authentication complete"
msgstr "Аутентификация завершена"
