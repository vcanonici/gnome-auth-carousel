msgid "Fingerprint"
msgstr "Відбиток пальця"

msgid "Place your index finger on the fingerprint reader"
msgstr "Прикладіть вказівний палець до сканера відбитків"

msgid "Fingerprint not recognized. Place your index finger again."
msgstr "Відбиток не розпізнано. Прикладіть вказівний палець ще раз."

msgid "Connect your Trezor and confirm on the device"
msgstr "Підключіть Trezor і підтвердьте на пристрої"

msgid "Trezor not confirmed. Try again."
msgstr "Trezor не підтвердив. Спробуйте ще раз."

msgid "Enter your password"
msgstr "Введіть пароль"

msgid "Password"
msgstr "Пароль"

msgid "Too many attempts. Enter your password again."
msgstr "Забагато спроб. Введіть пароль ще раз."

msgid "Try again. Enter your password."
msgstr "Спробуйте ще раз. Введіть пароль."

msgid "Authentication complete"
msgstr "Автентифікацію завершено"
