msgid "Fingerprint"
msgstr "Odcisk palca"

msgid "Place your index finger on the fingerprint reader"
msgstr "Przyłóż palec wskazujący do czytnika linii papilarnych"

msgid "Fingerprint not recognized. Place your index finger again."
msgstr "Nie rozpoznano odcisku. Przyłóż palec wskazujący ponownie."

msgid "Connect your Trezor and confirm on the device"
msgstr "Podłącz Trezor i potwierdź na urządzeniu"

msgid "Trezor not confirmed. Try again."
msgstr "Trezor nie potwierdził. Spróbuj ponownie."

msgid "Enter your password"
msgstr "Wpisz hasło"

msgid "Password"
msgstr "Hasło"

msgid "Too many attempts. Enter your password again."
msgstr "Zbyt wiele prób. Wpisz hasło ponownie."

msgid "Try again. Enter your password."
msgstr "Spróbuj ponownie. Wpisz hasło."

msgid "Authentication complete"
msgstr "Uwierzytelnianie zakończone"
