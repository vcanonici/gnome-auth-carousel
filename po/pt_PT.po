"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Fingerprint"
msgstr "Impressão digital"

msgid "Place your index finger on the fingerprint reader"
msgstr "Coloque o indicador no leitor de impressões digitais"

msgid "Fingerprint not recognized. Place your index finger again."
msgstr "Impressão digital não reconhecida. Coloque o indicador novamente."

msgid "Connect your Trezor and confirm on the device"
msgstr "Ligue o seu Trezor e confirme no dispositivo"

msgid "Trezor not confirmed. Try again."
msgstr "Trezor não confirmado. Tente novamente."

msgid "Enter your password"
msgstr "Introduza a sua palavra-passe"

msgid "Password"
msgstr "Palavra-passe"

msgid "Too many attempts. Enter your password again."
msgstr "Demasiadas tentativas. Introduza novamente a sua palavra-passe."

msgid "Try again. Enter your password."
msgstr "Tente novamente. Introduza a sua palavra-passe."

msgid "Authentication complete"
msgstr "Autenticação concluída"
