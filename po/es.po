msgid "Fingerprint"
msgstr "Huella digital"

msgid "Place your index finger on the fingerprint reader"
msgstr "Coloque el dedo índice en el lector de huellas"

msgid "Fingerprint not recognized. Place your index finger again."
msgstr "Huella no reconocida. Coloque el dedo índice de nuevo."

msgid "Connect your Trezor and confirm on the device"
msgstr "Conecte su Trezor y confirme en el dispositivo"

msgid "Trezor not confirmed. Try again."
msgstr "Trezor no confirmado. Inténtelo de nuevo."

msgid "Enter your password"
msgstr "Introduzca su contraseña"

msgid "Password"
msgstr "Contraseña"

msgid "Too many attempts. Enter your password again."
msgstr "Demasiados intentos. Introduzca su contraseña de nuevo."

msgid "Try again. Enter your password."
msgstr "Inténtelo de nuevo. Introduzca su contraseña."

msgid "Authentication complete"
msgstr "Autenticación completada"
