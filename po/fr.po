msgid "Fingerprint"
msgstr "Empreinte"

msgid "Place your index finger on the fingerprint reader"
msgstr "Posez l’index sur le lecteur d’empreintes"

msgid "Fingerprint not recognized. Place your index finger again."
msgstr "Empreinte non reconnue. Posez de nouveau l’index."

msgid "Connect your Trezor and confirm on the device"
msgstr "Branchez votre Trezor et confirmez sur l’appareil"

msgid "Trezor not confirmed. Try again."
msgstr "Trezor non confirmé. Réessayez."

msgid "Enter your password"
msgstr "Saisissez votre mot de passe"

msgid "Password"
msgstr "Mot de passe"

msgid "Too many attempts. Enter your password again."
msgstr "Trop de tentatives. Saisissez de nouveau votre mot de passe."

msgid "Try again. Enter your password."
msgstr "Réessayez. Saisissez votre mot de passe."

msgid "Authentication complete"
msgstr "Authentification terminée"
